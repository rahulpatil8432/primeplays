<LinearLayout android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
android:background="@color/back"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/toolbar"
        android:background="@color/background">

        <LinearLayout
            android:layout_width="wrap_content"
            android:orientation="horizontal"
            android:layout_height="wrap_content">

            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:id="@+id/back"
                android:layout_margin="15dp"
                app:cardElevation="5dp"
                app:cardCornerRadius="10dp"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    app:tint="@color/font"
                    android:src="@drawable/back"
                    android:layout_margin="10dp" />

            </androidx.cardview.widget.CardView>

            <com.rkonline.android.latobold
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:textColor="@color/md_black_1000"
                android:textSize="20sp"
                android:layout_marginLeft="10dp"
                android:text="Deposit Money" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>


    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:padding="20dp"
        android:weightSum="1"
        android:layout_height="match_parent">
        <!-- Balance Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="180dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- User Info -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:background="#394E5E">

                    <TextView
                        android:text="Mobile"
                        android:textSize="20sp"
                        android:textColor="#fff"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="9579418256"
                        android:textSize="18sp"
                        android:id="@+id/mobile"
                        android:textColor="#fff"
                        android:layout_marginTop="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                </LinearLayout>

                <!-- Balance -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:background="@color/primary">

                    <TextView
                        android:text="Available Balance"
                        android:textSize="16sp"
                        android:textColor="#fff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/walletBalance"
                        android:text="₹ 0.0"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#fff"
                        android:layout_marginTop="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>


        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/md_black_1000"
            android:layout_marginTop="20dp"
            />
        <!-- Support Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="For Fund Query's please Call Or Whatsapp"
            android:gravity="center"
            android:layout_marginTop="10dp"
            android:textSize="14sp"/>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="10dp">


            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/telegram" />

            <Button
                android:layout_width="120dp"
                android:layout_height="40dp"
                android:text="Telegram"
                android:id="@+id/call"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"/>

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/whatsapp" />

            <Button
                android:layout_width="120dp"
                android:layout_marginLeft="10dp"
                android:layout_height="40dp"
                android:id="@+id/whatsapp"
                android:text="Whatsapp"/>

        </LinearLayout>


        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/md_black_1000"
            android:layout_marginTop="20dp"
            />
        <!-- Enter Amount -->

        <EditText
            android:id="@+id/amount"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/edittext_rounded"
            android:layout_marginTop="20dp"
            android:hint="Enter Amount"
            android:paddingLeft="20dp"
            android:inputType="number"
            android:textSize="16sp"/>


        <!-- Quick Amount Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:gravity="center"
            >

            <Button
                android:layout_width="120dp"
                android:layout_height="45dp"
                android:text="500"
                android:id="@+id/five100"
                android:layout_weight="1"
                android:layout_marginRight="10dp"/>

            <Button
                android:layout_width="120dp"
                android:id="@+id/thousand"
                android:layout_weight="1"
                android:layout_height="45dp"
                android:text="1000"/>



        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <Button
                android:layout_width="match_parent"
                android:id="@+id/twothousand"
                android:layout_height="45dp"
                android:text="2000"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/md_black_1000"
            android:layout_marginTop="20dp"/>

        <Button
            android:id="@+id/pay"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Pay Now"
            android:textColor="#fff"
            android:textSize="18sp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/primary"/>
    </LinearLayout>

</LinearLayout>